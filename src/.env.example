# Copy to .env  (cp .env.example .env)
# Empty values fall back to the defaults in app/navigator/config.py.

# --- Apertus (Hack Apertus convention) --------------------------------------
LLM_NAME=swiss-ai/Apertus-v1.5-8B
# LLM_NAME=swiss-ai/Apertus-v1.5-70B     # needs 4 GPUs (add --tensor-parallel-size 4 in compose)
# OpenAI-compatible endpoint. Default in docker compose: the bundled vLLM (make up-gpu, http://vllm:8000/v1).
# Any other OpenAI-compatible Apertus endpoint (a shared GPU box, a hosted gateway) is set here. A remote endpoint
# means search queries and company requests are sent over the network to that provider at runtime.
# LLM_BASE_URL=http://gpu-box.local:8000/v1
LLM_API_KEY=
LLM_CONCURRENCY=8
# Stream completions (1, default): some gateways drop requests that stay silent for too long.
# LLM_STREAM=1
# Seconds per LLM request (default 120).
# LLM_TIMEOUT=120
# Only needed to download gated weights for the vLLM profile.
HF_TOKEN=

# --- Retrieval ---------------------------------------------------------------
EMBED_MODEL=intfloat/multilingual-e5-base
# Abstention thresholds (calibrate with: make eval)
MIN_VECTOR_SCORE=0.825
MIN_COVERAGE=0.5
MAX_PER_UNIT=3
USE_LLM_EXPANSION=1
USE_LLM_EXPLAIN=1
# The docker compose files set HF_HUB_OFFLINE=1 (the e5 model is baked into the image). For LOCAL=1 runs, set it
# after the first model download so the API never reaches Hugging Face at runtime.
# HF_HUB_OFFLINE=1

# --- Storage -------------------------------------------------------------------
# Empty (default): files in data/ (entities.jsonl, BM25 pickle, vectors, SQLite cases).
# Set: Postgres backend (src/db: nav schema + pgvector + AGE graph), e.g.
# DATABASE_URL=postgresql://bern_app:<APP_DB_PASSWORD>@db:5432/bern
DATABASE_URL=
# Postgres backend only: connection pool size and HNSW ef_search.
# PG_POOL_MAX=8
# PG_HNSW_EF_SEARCH=100
# File backend vectors: empty QDRANT_URL -> in-process NumPy store (data/vectors.npy);
# set -> Qdrant server. src/docker-compose.yml (make up) sets QDRANT_URL=http://qdrant:6333 itself;
# src/deploy/docker-compose.yml (team server) does not, so the server uses NumPy.
# QDRANT_URL=
# QDRANT_COLLECTION=expertise

# --- Paths (optional) ----------------------------------------------------------
# NAV_ROOT defaults to src/ (the directory holding config/ and data/); the other two default to $NAV_ROOT/config
# and $NAV_ROOT/data.
# NAV_ROOT=
# NAV_CONFIG_DIR=
# NAV_DATA_DIR=
