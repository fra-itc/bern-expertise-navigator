# Copy to .env  (cp .env.example .env)

# --- Apertus (Hack Apertus convention) --------------------------------------
LLM_NAME=swiss-ai/Apertus-v1.5-8B
# LLM_NAME=swiss-ai/Apertus-v1.5-70B     # needs 4 GPUs (add --tensor-parallel-size 4 in compose)
# OpenAI-compatible endpoint. Default in docker compose: the bundled vLLM (make up-gpu).
# For the hackathon / a shared GPU box / a sovereign Swiss cloud endpoint, set it here:
# LLM_BASE_URL=http://gpu-box.local:8000/v1
LLM_API_KEY=
LLM_CONCURRENCY=8
HF_TOKEN=

# --- Retrieval ---------------------------------------------------------------
EMBED_MODEL=intfloat/multilingual-e5-base
# Abstention thresholds (calibrate with: make eval)
MIN_VECTOR_SCORE=0.825
MIN_COVERAGE=0.5
MAX_PER_UNIT=3
USE_LLM_EXPANSION=1
USE_LLM_EXPLAIN=1

# --- Storage -------------------------------------------------------------------
# Empty (default): files in data/ (entities.jsonl, BM25, NumPy/Qdrant, SQLite cases).
# Set: Postgres backend (src/db: nav schema + pgvector + AGE graph), e.g.
# DATABASE_URL=postgresql://bern_app:<APP_DB_PASSWORD>@db:5432/bern
DATABASE_URL=

# --- Papers (python -m navigator.cli papers; network only on that explicit command) ---------------------------
# OpenAlex bills usage: without a key the whole IP shares $0.10/day (~100 author searches); a free key gives
# $1/day and 30 req/s (https://openalex.org/settings/api). The key is sent as a Bearer header, never logged.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# OPENALEX_RPS=5
# PAPERS_RORS=https://ror.org/02k7v4d05,https://ror.org/01q9sj412   # University of Bern, Inselspital
# PAPERS_MAX_WORKS=30  PAPERS_YEARS=10  PAPERS_PDF=1  PAPERS_PDF_MAX_MB=20  PAPERS_MAX_CHUNKS=8
# SIMILAR_K=5  SIMILAR_PERSON_THRESHOLD=auto  SIMILAR_QUANTILE=0.9  SIMILAR_MIN=0.80
# USE_PAPERS=1  PAPER_WEIGHT=0.8  SIMILAR_DAMPING=0.6
